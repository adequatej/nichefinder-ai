# Copy this file to .env and fill in your values.

# YouTube Data API v3 key. Create one in Google Cloud Console:
# 1. Create a project, enable "YouTube Data API v3"
# 2. Credentials -> Create credentials -> API key
# 3. Restrict the key to the YouTube Data API v3
# The key stays in this file only. It is never sent to the frontend.
YOUTUBE_API_KEY=

# Set to false to bypass the raw API response cache (used by benchmarks).
CACHE_ENABLED=true
